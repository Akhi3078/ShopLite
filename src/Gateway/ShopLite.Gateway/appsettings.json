{
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identity"
          }
        ]
      },
      "catalog": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/catalog/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/catalog"
          }
        ]
      },
      "ordering": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/ordering/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/ordering"
          }
        ]
      },
      "basket": {
        "//": "No PathRemovePrefix here, unlike identity and catalog. Those two expose their resources at the root (/auth, /products) so the gateway prefix is purely a routing label and has to come off. Basket's own resource is already /basket, so the prefix and the service path coincide and the request forwards unchanged. Its Scalar page is therefore not reachable through the gateway; use the direct URL in README.md.",
        "ClusterId": "basket",
        "Match": {
          "Path": "/basket/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity": {
            "Address": "http://localhost:5102/"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "catalog": {
            "Address": "http://localhost:5173/"
          }
        }
      },
      "basket": {
        "Destinations": {
          "basket": {
            "Address": "http://localhost:5190/"
          }
        }
      },
      "ordering": {
        "Destinations": {
          "ordering": {
            "Address": "http://localhost:5210/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
