<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The outermost layer: HTTP, OpenAPI, and composition. It deliberately has NO EF Core
       reference — persistence arrives via Catalog.Infrastructure. It depends on Application
       (to call use cases) and Infrastructure (to register implementations), and is the only
       project allowed to know both exist. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Aspire\ShopLite.ServiceDefaults\ShopLite.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Catalog.Application\Catalog.Application.csproj" />
    <ProjectReference Include="..\Catalog.Infrastructure\Catalog.Infrastructure.csproj" />
  </ItemGroup>

</Project>
